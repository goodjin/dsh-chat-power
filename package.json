{
  "name": "@goodjin2/dsh-chat-power",
  "version": "0.3.1",
  "description": "DSH conversation tools, editable file cards, answer cards and session utilities",
  "type": "module",
  "main": "./src/entry.ts",
  "types": "./src/entry.ts",
  "exports": {
    ".": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./client": {
      "types": "./src/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./mermaid-asset": {
      "types": "./src/mermaid-asset.ts",
      "default": "./src/mermaid-asset.ts"
    },
    "./workspace-write": {
      "types": "./src/workspace-write.ts",
      "default": "./src/workspace-write.ts"
    },
    "./session-id-bar": {
      "types": "./src/session-id-bar/index.ts",
      "default": "./src/session-id-bar/index.ts"
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:client": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.dom.config.ts"
  },
  "dependencies": {
    "mermaid": "^11.16.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "18.3.1",
    "clsx": "^2.1.1",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadharbor/dsh-chat-power.git"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3"
  }
}
